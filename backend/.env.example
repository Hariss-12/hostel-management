# ---- Server ----
PORT=5000
# Frontend address(es) allowed to call this API (comma separated)
CLIENT_URL=http://localhost:5173

# ---- MongoDB ----
# For Atlas, authenticate against admin; URL-encode special characters in the password.
# Keep the URI private; use your MongoDB Atlas connection string or local URI.
MONGODB_URI=mongodb+srv://<atlas-db-username>:<url-encoded-password>@<cluster-host>/?retryWrites=true&w=majority&authSource=admin
# The app selects this database separately from the connection URI.
MONGODB_DB=hostel_management

# ---- Authentication ----
# Use a long random string, e.g. generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h

# ---- First admin account (used only by: npm run create-admin) ----
ADMIN_NAME=Hostel Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Optional local-only showcase scripts; keep the password out of tracked files.
DEMO_PASSWORD=
