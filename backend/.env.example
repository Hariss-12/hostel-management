# ---- Server ----
PORT=5000
# Frontend address(es) allowed to call this API (comma separated)
CLIENT_URL=http://localhost:5173

# ---- PostgreSQL (replace the placeholders with your own values) ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_postgres_username
DB_PASSWORD=your_postgres_password
DB_NAME=hostel_management
# Optional: a single connection string instead of the DB_* values above
# DATABASE_URL=postgresql://your_postgres_username:your_postgres_password@localhost:5432/hostel_management
# Set to true for hosted databases reached from outside (e.g. Render External Database URL)
# DB_SSL=true

# ---- Authentication ----
# Use a long random string, e.g. generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h

# ---- First admin account (used only by: npm run create-admin) ----
ADMIN_NAME=Hostel Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123
